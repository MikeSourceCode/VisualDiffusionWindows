# OS
.DS_Store

# Python virtual environment / installed packages
development/
development_glyph/

# Scratch: one-off helpers and diagnostics kept locally as reference, not committed
scratch/

# Python bytecode cache
__pycache__/
*.py[cod]

# Generated outputs — keep the folder, ignore its contents
outputs/**
!outputs/**/
!outputs/.gitkeep

# Model weights, tokenizers, and component configs — download separately.
# Keep the folder structure and each folder's README.md as a reference.
models/**
!models/**/
!models/**/README.md

# Model weight / checkpoint formats anywhere in the repo
*.safetensors
*.ckpt
*.pt
*.pth
*.bin

# Core engine local SQLite preset DB (created at runtime)
core/presets.db

# Operator configuration — generated by setup.py, not committed
config/app_config.json
